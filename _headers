# Cloudflare Pages: Apple expects this file with Content-Type application/json
# https://developers.cloudflare.com/pages/configuration/headers/

/.well-known/apple-app-site-association
  Content-Type: application/json

/focus-training/*
  X-Robots-Tag: noindex, nofollow

# Fuel log is a private tool. Do not index it. The service worker must revalidate.
/fuel/*
  X-Robots-Tag: noindex, nofollow

/fuel/sw.js
  Cache-Control: no-cache

/fuel/manifest.webmanifest
  Content-Type: application/manifest+json

# Trip log is a private tool. Do not index it. The service worker must revalidate.
/trips/*
  X-Robots-Tag: noindex, nofollow

/trips/sw.js
  Cache-Control: no-cache

/trips/manifest.webmanifest
  Content-Type: application/manifest+json
